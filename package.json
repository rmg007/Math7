{
  "name": "workspace",
  "version": "1.0.0",
  "description": "> **The \"Golden Command\" to start development:** >  > ```text > \"Follow the instructions in AGENTS.md. Start with Phase 0.\" > ```",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "npm run test:e2e --prefix admin-panel",
    "deps:validate": "depcruise admin-panel/src landing-pages/src --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise admin-panel/src landing-pages/src --config .dependency-cruiser.cjs --output-type dot > dependency-graph.dot",
    "deps:archi": "depcruise admin-panel/src landing-pages/src --config .dependency-cruiser.cjs --output-type archi > architecture-graph.dot",
    "deps:report": "depcruise admin-panel/src landing-pages/src --config .dependency-cruiser.cjs --output-type html > dependency-report.html",
    "setup:all": "npm run setup:web && npm run setup:mobile",
    "setup:web": "echo 'Web setup: Open in VS Code and use \"Reopen in Container\" or run: devcontainer up'",
    "setup:mobile": "bash scripts/setup-mobile.sh",
    "dev:web": "cd admin-panel && npm run dev",
    "dev:mobile": "cd student-app && flutter run",
    "test:web": "cd admin-panel && npm run test",
    "test:mobile": "cd student-app && flutter test",
    "build:web": "cd admin-panel && npm run build",
    "build:mobile": "cd student-app && flutter build apk",
    "clean:web": "cd admin-panel && rm -rf node_modules dist && npm install",
    "clean:mobile": "cd student-app && flutter clean && flutter pub get",
    "validate": "bash scripts/validate-environment.sh",
    "doctor:mobile": "flutter doctor -v",
    "clean:all": "bash scripts/cleanup-all.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/extension-underline": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "dotenv": "^17.2.3",
    "katex": "^0.16.28",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.3.7"
  }
}