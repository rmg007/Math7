{
  "name": "workspace",
  "version": "1.0.0",
  "description": "> **The \"Golden Command\" to start development:** >  > ```text > \"Follow the instructions in AGENTS.md. Start with Phase 0.\" > ```",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "npm run test:e2e --prefix admin-panel",
    "typegen": "supabase gen types typescript --project-id bkfhorslctqieetzqdtd > packages/core/src/types/database.types.ts",
    "deps:validate": "depcruise admin-panel/src --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise admin-panel/src --config .dependency-cruiser.cjs --output-type dot > dependency-graph.dot",
    "deps:archi": "depcruise admin-panel/src --config .dependency-cruiser.cjs --output-type archi > architecture-graph.dot",
    "deps:report": "depcruise admin-panel/src --config .dependency-cruiser.cjs --output-type html > dependency-report.html",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/extension-underline": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.20.0",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.2.3",
    "katex": "^0.16.28",
    "pg": "^8.18.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@types/node": "^25.2.2",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "supabase": "^2.76.6",
    "tsx": "^4.21.0"
  }
