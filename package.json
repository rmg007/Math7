{
  "name": "workspace",
  "version": "1.0.0",
  "description": "> **The \"Golden Command\" to start development:** >  > ```text > \"Follow the instructions in AGENTS.md. Start with Phase 0.\" > ```",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "npm run test:e2e --prefix admin-panel",
    "typegen": "supabase gen types typescript --project-id bkfhorslctqieetzqdtd > packages/core/src/types/database.ts",
    "deps:validate": "depcruise admin-panel/src --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise admin-panel/src --config .dependency-cruiser.cjs --output-type dot > dependency-graph.dot",
    "deps:archi": "depcruise admin-panel/src --config .dependency-cruiser.cjs --output-type archi > architecture-graph.dot",
    "deps:report": "depcruise admin-panel/src --config .dependency-cruiser.cjs --output-type html > dependency-report.html",
    "prepare": "husky || true",
    "release": "standard-version"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "standard-version": "^9.5.0",
    "supabase": "^2.76.6",
    "tsx": "^4.21.0"
  }
}
