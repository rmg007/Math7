{
  "name": "questerix-cortex",
  "version": "1.0.0",
  "description": "Session Handover and QA Intelligence System for Questerix",
  "main": "run.ts",
  "scripts": {
    "health": "ts-node run.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "cortex:selftest": "node dist/scripts/selftest.js",
    "cortex:setup": "node dist/scripts/setup.js",
    "lint": "eslint . --ext ts",
    "format": "prettier --write \"**/*.ts\"",
    "governance:check": "ts-node src/governance/cli.ts --check"
  },
  "bin": {
    "cortex-mcp-server": "./dist/src/mcp-server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "agentops": "^0.1.0",
    "better-sqlite3": "^12.6.2",
    "chalk": "^4.1.2",
    "express": "^4.21.2",
    "glob": "^11.0.1",
    "open": "^8.4.2",
    "socket.io": "^4.8.1",
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/glob": "^8.1.0",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
