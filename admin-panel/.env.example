# Questerix Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================
# Get these from: https://supabase.com/dashboard → QuesterixDB-v2 → Settings → API

# Project URL
VITE_SUPABASE_URL=https://zrxvlcvdtfqzqvgqjjvt.supabase.co

# Anon/Public Key (safe for client-side)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ⚠️ DO NOT ADD SERVICE ROLE KEY HERE
# Service role key should ONLY exist in:
# 1. Supabase Edge Functions (server-side)
# 2. GitHub Secrets (for CI/CD)
# 3. Cloudflare environment variables (for deployment)

# ============================================
# TEST CONFIGURATION (OPTIONAL)
# ============================================
# For running E2E tests locally

# Test user credentials (create a test user in Supabase Auth)
VITE_TEST_USER_EMAIL=test@example.com
VITE_TEST_USER_PASSWORD=test123

# Test admin credentials
VITE_TEST_ADMIN_EMAIL=admin@test.com
VITE_TEST_ADMIN_PASSWORD=admin123

# ============================================
# DEVELOPMENT CONFIGURATION (OPTIONAL)
# ============================================

# Enable debug logging
VITE_DEBUG=false

# API timeout (milliseconds)
VITE_API_TIMEOUT=30000

# ============================================
# NOTES
# ============================================
# 
# 1. NEVER commit .env.local files to git
# 2. Service role keys belong ONLY on the server
# 3. Use GitHub Codespaces Secrets for sensitive values
# 4. Anon key is safe for client-side (it's public)
# 5. Test credentials should be separate test accounts
#
# ============================================
