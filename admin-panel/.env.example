# Supabase Configuration
# Get these from your Supabase project settings (https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# App Metadata
VITE_APP_NAME=Questerix Admin
VITE_APP_VERSION=0.9.0

# AI Configuration (Phase 12)
VITE_GEMINI_API_KEY=[YOUR-GEMINI-KEY]

# Features & Analytics
VITE_ENABLE_OFFLINE_MODE=false
VITE_ANALYTICS_ID=[YOUR-GA-ID]
VITE_ENABLE_DEBUG_LOGGING=true
