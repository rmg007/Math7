#!/bin/sh

# ==========================================
# PRE-COMMIT HOOK: Code Quality + Secret Guard
# ==========================================

# Layer 1: Lint-staged (ESLint + Prettier on staged files)
npx lint-staged

# Layer 1c: Global Typecheck (Prevention for missing imports/contract drift)
echo "Running typecheck for admin-panel..."
cd admin-panel && npm run typecheck && cd ..

# Layer 1b: Quick forbidden-pattern check on staged files
echo "Checking staged files for forbidden patterns..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|dart|md)$' | grep -v 'node_modules' | grep -v '.example')
echo "Staged files to check: $STAGED_FILES"

if [ -n "$STAGED_FILES" ]; then
  FORBIDDEN=$(echo "$STAGED_FILES" | xargs grep -l -E '(eyJ[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{20,}|SUPABASE_SERVICE_ROLE|service_role_key)' 2>/dev/null || true)
  if [ -n "$FORBIDDEN" ]; then
    echo ""
    echo "❌ POTENTIAL SECRET DETECTED in staged files:"
    echo "$FORBIDDEN"
    echo ""
    echo "Files affected:"
    echo "$FORBIDDEN"
    echo ""
    echo "If this is a false positive (e.g., test fixture), use: git commit --no-verify"
    exit 1
  fi
fi
echo "✅ Secret check passed."
