{
  "name": "Questerix Development Environment",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/flutter:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/powershell:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.copilot",
        "eamodio.gitlens",
        "ms-vscode.powershell"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": true
        },
        "[python]": {
          "editor.defaultFormatter": "ms-python.python"
        },
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
          "**/node_modules": true,
          "**/.dart_tool": true,
          "**/build": true
        }
      }
    }
  },

  "postCreateCommand": "bash scripts/setup-codespaces.sh",

  "forwardPorts": [5173, 3000, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Admin Panel (Vite)",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Student App (Flutter)",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Content Engine (Python)",
      "onAutoForward": "ignore"
    }
  },

  "remoteUser": "codespace",

  "secrets": {
    "VITE_SUPABASE_URL": {
      "description": "Supabase project URL (https://zrxvlcvdtfqzqvgqjjvt.supabase.co)",
      "documentationUrl": "https://supabase.com/dashboard/project/zrxvlcvdtfqzqvgqjjvt/settings/api"
    },
    "VITE_SUPABASE_ANON_KEY": {
      "description": "Supabase anon/public key (safe for client-side)",
      "documentationUrl": "https://supabase.com/dashboard/project/zrxvlcvdtfqzqvgqjjvt/settings/api"
    },
    "VITE_TEST_USER_EMAIL": {
      "description": "Test user email for E2E tests (optional)",
      "documentationUrl": "https://github.com/rmg007/Questerix/blob/main/CODESPACES.md"
    },
    "VITE_TEST_USER_PASSWORD": {
      "description": "Test user password for E2E tests (optional)",
      "documentationUrl": "https://github.com/rmg007/Questerix/blob/main/CODESPACES.md"
    }
  }
}
