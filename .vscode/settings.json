{
  // ── Editor ────────────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "files.autoSave": "afterDelay",

  // ── TypeScript ────────────────────────────────────────────────────────────
  "typescript.tsdk": "admin-panel/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ── ESLint ────────────────────────────────────────────────────────────────
  "eslint.workingDirectories": ["admin-panel"],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // ── File Explorer Exclusions (hidden from sidebar) ────────────────────────
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/.dart_tool": true,
    "**/coverage": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.wrangler": true,
    "**/.supabase": true,
    "**/questerix-cortex/dist": true,
    "**/.session": true,
    "**/_gh_failures": true
  },

  // ── Search Exclusions (not indexed for Ctrl+Shift+F) ─────────────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/coverage": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.wrangler": true,
    "**/.supabase": true,
    "**/questerix-cortex/dist": true,
    "**/.gemini/antigravity/knowledge": true,
    "**/*.min.js": true,
    "**/*.map": true,
    "**/questerix-cortex/outputs": true,
    "**/package-lock.json": true,
    "**/database.types.utf8.ts": true,
    "**/database.types.ts": true,
    "**/*.chunk.js": true,
    "**/*.min.css": true,
    "**/*.chunk.css": true,
    "**/.idea": true,
    "**/landing-pages": true,
    "**/student-app": true
  },

  // ── File Watcher Exclusions (reduces CPU/disk I/O dramatically) ───────────
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.wrangler/**": true,
    "**/.supabase/**": true,
    "**/questerix-cortex/dist/**": true,
    "**/questerix-cortex/outputs/**": true,
    "**/.gemini/antigravity/knowledge/**": true,
    "**/.session/**": true,
    "**/.dart_tool/**": true,
    "**/_gh_failures/**": true
  },

  // ── Terminal ──────────────────────────────────────────────────────────────
  "terminal.integrated.shellIntegration.enabled": false,

  // ── Python ────────────────────────────────────────────────────────────────
  "python.defaultInterpreterPath": "C:\\Python313\\python.exe"
}